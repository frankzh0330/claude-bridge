# --- Channel configuration ---

# Each channel needs: TYPE, TOKEN, CWD
# Supported types: telegram (slack, discord coming soon)

# Channel 1
CHANNEL_1_TYPE=telegram
CHANNEL_1_TOKEN=your-telegram-bot-token
CHANNEL_1_CWD=/path/to/project-a
CHANNEL_1_USER_ID=your-numeric-telegram-user-id

# Channel 2 (add more channels as needed)
# CHANNEL_2_TYPE=telegram
# CHANNEL_2_TOKEN=another-bot-token
# CHANNEL_2_CWD=/path/to/project-b
# CHANNEL_2_USER_ID=your-numeric-telegram-user-id

# Optional (defaults apply to all channels)
# CHANNEL_<N>_MAX_TURNS=30
# CHANNEL_<N>_MAX_BUDGET_USD=1.0
# MESSAGE_EXPIRY_MINUTES=20
