# Required
ALLOWED_USER_ID=your-numeric-telegram-user-id

# --- Single bot mode ---
# BOT_TOKEN=your-bot-token
# BOT_CWD=/path/to/project

# --- Multi bot mode ---
# BOT_1_TOKEN=bot1-token
# BOT_1_CWD=/path/to/project-a
# BOT_2_TOKEN=bot2-token
# BOT_2_CWD=/path/to/project-b

# Optional (defaults apply to all bots)
# BOT_MAX_TURNS=30
# BOT_MAX_BUDGET_USD=1.0
# BOT_<N>_MAX_TURNS=30
# BOT_<N>_MAX_BUDGET_USD=1.0
# MESSAGE_EXPIRY_MINUTES=20
